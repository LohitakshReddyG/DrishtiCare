# DrishtiCare - Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local or cloud deployments.

# --- Storage Settings ---
# "local" for SQLite & local disk (testing/pilot) or "cloud" for PostgreSQL & S3/R2
STORAGE_MODE=local
IMAGE_STORAGE_PATH=./data/images

# --- Database Settings ---
# Local SQLite database (default)
DATABASE_URL=sqlite:///./data/drishticare.db
# For PostgreSQL (Phase 6 / Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/drishticare

# --- Cloud S3 / Cloudflare R2 / Backblaze B2 (Required only when STORAGE_MODE=cloud) ---
S3_BUCKET_NAME=drishticare-fundus-images
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key_here
# S3_SECRET_ACCESS_KEY=your_secret_key_here
# S3_REGION_NAME=ap-south-1
# S3_PUBLIC_CDN_URL=https://cdn.drishticare.org

# --- Security & Health Worker JWT Auth (Phase 8) ---
JWT_SECRET_KEY=drishticare_clinical_secret_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- ML & Quality Thresholds ---
MODEL_WEIGHTS_PATH=./backend/app/ml/model_referable_dr.pt
MIN_LAPLACIAN_VAR=5.0
MIN_BRIGHTNESS=25.0
MAX_BRIGHTNESS=220.0

